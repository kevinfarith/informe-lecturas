{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && VITE_API_SAME_ORIGIN=1 npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{web/**,.venv/**,.github/**}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/main" }]
}
